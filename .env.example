# Copy to .env and fill in. Never commit .env.

# Infrastructure (defaults match docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=tradinglab
POSTGRES_USER=tradinglab
POSTGRES_PASSWORD=tradinglab
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_PORT=19092
# false runs without Kafka: order events stay inside core-service.
KAFKA_ENABLED=true

# External services
ALPACA_API_KEY_ID= 
ALPACA_API_SECRET_KEY=
ANTHROPIC_API_KEY=
EMBEDDINGS_API_KEY=
SEC_USER_AGENT="Trading Lab your-email@example.com"

# Secrets
# Required, at least 32 characters. Generate one with: openssl rand -base64 32
JWT_SIGNING_KEY=
# Shared by core-service and ai-service. Any long random string; empty turns AI features off.
AI_SERVICE_TOKEN=

# Auth (false only for local http; deployed defaults are true and WEB_ORIGIN must be the real site)
AUTH_COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000

# AI (optional)
AI_SERVICE_URL=http://localhost:8000
# Tokens per user per day across all AI features.
AI_DAILY_TOKEN_BUDGET=200000

# alpaca or replay
MARKETDATA_PROVIDER=alpaca

# true fills paper orders while the US market is closed, at the last traded price. Local testing only.
TRADING_IGNORE_MARKET_HOURS=false
