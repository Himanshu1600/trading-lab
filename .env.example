# Copy to .env and fill in. Never commit .env.

# Infrastructure (defaults match docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=tradinglab
POSTGRES_USER=tradinglab
POSTGRES_PASSWORD=tradinglab
REDIS_HOST=localhost
REDIS_PORT=6379

# External services
ALPACA_API_KEY_ID= 
ALPACA_API_SECRET_KEY=
ANTHROPIC_API_KEY=
EMBEDDINGS_API_KEY=
SEC_USER_AGENT="Trading Lab your-email@example.com"

# Secrets
# Required, at least 32 characters. Generate one with: openssl rand -base64 32
JWT_SIGNING_KEY=
AI_SERVICE_TOKEN=

# Auth (false only for local http; deployed defaults are true and WEB_ORIGIN must be the real site)
AUTH_COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000

# alpaca or replay
MARKETDATA_PROVIDER=alpaca
